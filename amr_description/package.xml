<?xml version="1.0"?>
<package format="3">
  <name>amr_description</name>
  <version>0.0.1</version>
  <description>Laptop-side visualization of the AMR: RViz config that subscribes to the robot_description/TF/scan published remotely by the Pi (amr_bringup). Also holds an optional Gazebo sim of the same robot for offline testing.</description>
  <maintainer email="you@example.com">Arun</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
